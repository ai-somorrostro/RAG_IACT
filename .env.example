# Hugging Face
# -----------

# Token de acceso (opcional). Solo hace falta para modelos privados o con
# acceso restringido. Consíguelo en https://huggingface.co/settings/tokens
# HF_TOKEN=

# Carpeta de caché de modelos (opcional).
# Si no se define, Hugging Face usa ~/.cache/huggingface
# HF_HOME=
